# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gharstay?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Frontend
# Leave as "/api" to use the Vite dev proxy (no CORS in development).
# Use an absolute URL (e.g. "https://api.example.com/api") only for cross-origin deployments.
VITE_API_URL="/api"